{
  "name": "oat-docs",
  "version": "0.1.0",
  "description": "An open-source toolkit for portable, provider-agnostic agent tooling and workflows.",
  "scripts": {
    "predev": "fumadocs-mdx && pnpm -w run cli:source -- docs generate-index --docs-dir apps/oat-docs/docs --output apps/oat-docs/index.md",
    "dev": "next dev",
    "prebuild": "fumadocs-mdx && pnpm -w run cli:source -- docs generate-index --docs-dir apps/oat-docs/docs --output apps/oat-docs/index.md",
    "build": "next build",
    "start": "next start",
    "check": "oxfmt --check 'docs/**/*.md' && markdownlint-cli2 'docs/**/*.md'",
    "docs:lint": "markdownlint-cli2 'docs/**/*.md'",
    "docs:format": "oxfmt --write 'docs/**/*.md'",
    "docs:format:check": "oxfmt --check 'docs/**/*.md'"
  },
  "dependencies": {
    "@open-agent-toolkit/docs-config": "workspace:*",
    "@open-agent-toolkit/docs-theme": "workspace:*",
    "@open-agent-toolkit/docs-transforms": "workspace:*",
    "fumadocs-core": "^16.10.2",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-ui": "^16.10.2",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@open-agent-toolkit/cli": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "markdownlint-cli2": "^0.13.0",
    "oxfmt": "^0.36.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3"
  }
}
