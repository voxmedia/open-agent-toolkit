{
  "name": "oat-docs",
  "version": "0.1.0",
  "description": "An open-source toolkit for portable, provider-agnostic agent tooling and workflows.",
  "type": "module",
  "scripts": {
    "predev": "pnpm docs:skills:check && fumadocs-mdx && pnpm -w run cli:source -- docs generate-index --docs-dir apps/oat-docs/docs --output apps/oat-docs/index.md",
    "dev": "next dev",
    "prebuild": "pnpm docs:skills:check && fumadocs-mdx && pnpm -w run cli:source -- docs generate-index --docs-dir apps/oat-docs/docs --output apps/oat-docs/index.md && pnpm -w run cli:source -- docs nav sync --target-dir apps/oat-docs --check",
    "build": "next build",
    "start": "next start",
    "check": "oxlint scripts tests && oxfmt --check scripts tests && oxfmt --check 'docs/**/*.md' && markdownlint-cli2 'docs/**/*.md' && pnpm docs:validate",
    "docs:validate": "tsx --tsconfig tsconfig.docs-tools.json scripts/validate.ts && pnpm docs:skills:check",
    "docs:skills:validate": "tsx --tsconfig tsconfig.docs-tools.json scripts/skill-mapping.ts",
    "docs:skills:generate": "tsx --tsconfig tsconfig.docs-tools.json scripts/skill-catalog.ts --write",
    "docs:skills:check": "tsx --tsconfig tsconfig.docs-tools.json scripts/skill-catalog.ts --check",
    "test": "tsx --tsconfig tsconfig.docs-tools.json --test tests/*.test.ts",
    "type-check": "tsc --noEmit -p tsconfig.docs-tools.json",
    "docs:lint": "markdownlint-cli2 'docs/**/*.md'",
    "docs:format": "oxfmt --write 'docs/**/*.md'",
    "docs:format:check": "oxfmt --check 'docs/**/*.md'"
  },
  "dependencies": {
    "@open-agent-toolkit/docs-config": "workspace:*",
    "@open-agent-toolkit/docs-theme": "workspace:*",
    "@open-agent-toolkit/docs-transforms": "workspace:*",
    "fumadocs-core": "^16.10.2",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-ui": "^16.10.2",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@open-agent-toolkit/cli": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "github-slugger": "^2.0.0",
    "markdownlint-cli2": "^0.13.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "unified": "^11.0.5",
    "yaml": "2.8.2"
  }
}
