{
  "schemaVersion": "explainer-kit.author-result/v2",
  "artifactId": "walkthrough",
  "content": {
    "html": "<!doctype html>\n<!--\n  Neutral production shell. Worked content: ../examples/\n  TEMPLATE CONTRACT: THEME_CSS, TITLE, DESCRIPTION, SLIDES\n  SLIDES contains semantic section.slide elements with escaped content.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Explainer authoring redesign — walkthrough</title>\n    <meta name=\"description\" content=\"A six-frame walkthrough of why Explainer Kit produced thin output, the two-path authoring model that replaced it, and what the validation does and does not prove.\" />\n    <script>\n      document.documentElement.classList.add('js');\n    </script>\n    <style>\n      :root {\n        --canvas: hsl(210 20% 98%);\n        --panel: hsl(0 0% 100%);\n        --border: hsl(210 14% 80%);\n        --ink: hsl(215 24% 16%);\n        --muted: hsl(215 12% 38%);\n        --accent: hsl(215 28% 32%);\n        --sans: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;\n        --serif: ui-serif, Georgia, serif;\n        --mono: ui-monospace, SFMono-Regular, Consolas, monospace;\n        /* AUTHOR EXTENSION REGION: resolved theme tokens */\n        --canvas: #f4f6f9;\n        --panel: #ffffff;\n        --elevated: #eef1f5;\n        --ink: #16202e;\n        --muted: #4a5568;\n        --accent: #2f56c9;\n        --accent-secondary: #0e7180;\n      }\n      * {\n        box-sizing: border-box;\n      }\n      html,\n      body {\n        margin: 0;\n        min-height: 100%;\n      }\n      body {\n        background: var(--canvas);\n        color: var(--ink);\n        font-family: var(--sans);\n      }\n      noscript p {\n        color: var(--muted);\n      }\n      .deck {\n        display: flex;\n        width: 100%;\n        height: 100dvh;\n        overflow-x: auto;\n        overflow-y: hidden;\n        scroll-snap-type: x mandatory;\n        scroll-behavior: smooth;\n        overscroll-behavior-x: contain;\n      }\n      .slide {\n        flex: 0 0 100%;\n        width: 100%;\n        min-width: 0;\n        height: 100dvh;\n        overflow: hidden;\n        scroll-snap-align: start;\n        scroll-snap-stop: always;\n        display: grid;\n        place-items: center;\n        padding: clamp(2rem, 7vw, 7rem);\n        border-inline-end: 1px solid var(--border);\n      }\n      .slide__content {\n        width: min(100%, 72rem);\n        max-width: 100%;\n        max-height: 100%;\n        min-width: 0;\n        overflow-x: auto;\n        overflow-y: auto;\n        overflow-wrap: anywhere;\n        padding: 0.25rem;\n      }\n      .slide h1,\n      .slide h2 {\n        max-width: 24ch;\n        font-family: var(--serif);\n        font-size: clamp(2rem, 6vw, 4.5rem);\n        line-height: 1.08;\n        margin-block: 0 1rem;\n        text-wrap: balance;\n      }\n      .slide p,\n      .slide li {\n        max-width: 52ch;\n        font-size: clamp(1rem, 2.2vw, 1.45rem);\n        line-height: 1.5;\n      }\n      .table-scroll,\n      pre {\n        max-width: 100%;\n        overflow-x: auto;\n      }\n      .deck-controls {\n        position: fixed;\n        z-index: 3;\n        inset: auto 1rem 1rem auto;\n        display: flex;\n        align-items: center;\n        gap: 0.4rem;\n        border: 1px solid var(--border);\n        border-radius: 999px;\n        background: var(--panel);\n        padding: 0.35rem;\n        font: 0.75rem var(--mono);\n      }\n      .deck-controls button {\n        border: 0;\n        border-radius: 50%;\n        background: transparent;\n        color: var(--ink);\n        min-width: 2rem;\n        min-height: 2rem;\n        cursor: pointer;\n      }\n      .deck-controls button:focus-visible {\n        outline: 2px solid var(--accent);\n        outline-offset: 2px;\n      }\n      .deck-progress {\n        position: fixed;\n        z-index: 4;\n        inset: auto 0 0;\n        height: 0.25rem;\n        background: var(--panel);\n      }\n      .deck-progress__bar {\n        display: block;\n        width: 0;\n        height: 100%;\n        background: var(--accent);\n        transition: width 180ms ease;\n      }\n      html:not(.js) .deck {\n        display: block;\n        height: auto;\n        overflow: visible;\n        scroll-snap-type: none;\n      }\n      html:not(.js) .slide {\n        min-height: auto;\n        height: auto;\n        overflow: visible;\n        border-block-end: 1px solid var(--border);\n      }\n      html:not(.js) .slide__content {\n        max-height: none;\n        overflow-x: auto;\n        overflow-y: visible;\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .deck {\n          scroll-behavior: auto;\n        }\n        .deck-progress__bar {\n          transition: none;\n        }\n      }\n      @media (max-height: 42rem) {\n        .slide {\n          padding-block: 1.5rem 4rem;\n        }\n        .slide__content {\n          overflow-y: auto;\n        }\n      }\n      @media print {\n        .deck {\n          display: block;\n          width: auto;\n          height: auto;\n          overflow: visible;\n          scroll-snap-type: none;\n        }\n        .slide {\n          display: block;\n          width: auto;\n          height: auto;\n          min-height: auto;\n          overflow: visible;\n          break-after: page;\n          border: 0;\n          padding: 2rem 0;\n        }\n        .slide__content {\n          width: auto;\n          max-height: none;\n          overflow: visible;\n        }\n        .deck-controls {\n          display: none;\n        }\n        .deck-progress {\n          display: none;\n        }\n      }\n    </style>\n  </head>\n  <body data-explainer-shell=\"deck-shell\">\n    <noscript>\n      <p>This deck remains available below as a readable vertical document.</p>\n    </noscript>\n    <main class=\"deck\" data-shell-anchor=\"deck\" aria-label=\"Explainer authoring redesign — walkthrough\">\n      <!-- AUTHOR EXTENSION REGION: semantic section.slide frames -->\n      <section class=\"slide\"><div><p style=\"font: 0.8rem/1.4 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-block-end: 0.75rem\">Project recap · walkthrough</p><h2 style=\"font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-block: 0 1.25rem; text-wrap: balance\">Explainer Kit stopped producing explainers worth reading</h2><p style=\"font-size: clamp(1.1rem, 2.2vw, 1.6rem); line-height: 1.5; max-width: 44rem; color: var(--muted)\">A recap the kit produced was, in the reviewer's words, \"basic AF\" — while passing every gate the kit owned. This walkthrough covers why, and what changed.</p></div></section><section class=\"slide\"><div><p style=\"font: 0.8rem/1.4 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-block-end: 0.75rem\">Request → diagnosis</p><h2 style=\"font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-block: 0 1.25rem; text-wrap: balance\">The cause was where quality lived, not how hard it was enforced</h2><ul style=\"margin: 0; padding-inline-start: 1.4rem; font-size: clamp(1rem, 1.8vw, 1.35rem); line-height: 1.6; max-width: 46rem\"><li style=\"margin-block-end: 0.6rem\"><strong>Before:</strong> editorial expectations encoded as schema. Authors filled fixed slots, so every recap had the same shape.</li><li style=\"margin-block-end: 0.6rem\"><strong>Tightening the schema made it worse</strong> — the schema described shapes, not quality.</li><li style=\"margin-block-end: 0.6rem\"><strong>After:</strong> expectations live in author briefs as prose; schemas define only machine boundaries.</li></ul></div></section><section class=\"slide\"><div><p style=\"font: 0.8rem/1.4 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-block-end: 0.75rem\">As-built architecture</p><h2 style=\"font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-block: 0 1.25rem; text-wrap: balance\">Two paths, chosen by policy rather than by the author</h2><svg viewBox=\"0 0 900 300\" role=\"img\" aria-label=\"Author seam fans out to a narrative renderer and an artistic composer, both converging on safety checks and approval\" style=\"width: 100%; max-width: 52rem; height: auto\"><defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"currentColor\" opacity=\"0.55\"></path></marker></defs><g><rect x=\"10\" y=\"110\" width=\"180\" height=\"80\" rx=\"10\" fill=\"var(--panel)\" stroke=\"#2f56c9\" stroke-width=\"2\"></rect><text x=\"100\" y=\"156\" text-anchor=\"middle\" font-size=\"18\" fill=\"var(--ink)\">Author seam</text></g><g><rect x=\"270\" y=\"20\" width=\"200\" height=\"80\" rx=\"10\" fill=\"var(--panel)\" stroke=\"#0e7180\" stroke-width=\"2\"></rect><text x=\"370\" y=\"66\" text-anchor=\"middle\" font-size=\"18\" fill=\"var(--ink)\">Narrative</text></g><g><rect x=\"270\" y=\"200\" width=\"200\" height=\"80\" rx=\"10\" fill=\"var(--panel)\" stroke=\"#965108\" stroke-width=\"2\"></rect><text x=\"370\" y=\"246\" text-anchor=\"middle\" font-size=\"18\" fill=\"var(--ink)\">Artistic</text></g><g><rect x=\"550\" y=\"110\" width=\"200\" height=\"80\" rx=\"10\" fill=\"var(--panel)\" stroke=\"#6a4fc4\" stroke-width=\"2\"></rect><text x=\"650\" y=\"156\" text-anchor=\"middle\" font-size=\"18\" fill=\"var(--ink)\">Safety + approval</text></g><path d=\"M 190 135 C 230 135 230 60 270 60\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path d=\"M 190 165 C 230 165 230 240 270 240\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path d=\"M 470 60 C 510 60 510 135 550 135\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path d=\"M 470 240 C 510 240 510 165 550 165\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path></svg></div></section><section class=\"slide\"><div><p style=\"font: 0.8rem/1.4 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-block-end: 0.75rem\">Decision · trade-off</p><h2 style=\"font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-block: 0 1.25rem; text-wrap: balance\">The load-bearing decision: no content generator ships</h2><ul style=\"margin: 0; padding-inline-start: 1.4rem; font-size: clamp(1rem, 1.8vw, 1.35rem); line-height: 1.6; max-width: 46rem\"><li style=\"margin-block-end: 0.6rem\">Bundling a generator would recreate the slot-filling rigidity being removed.</li><li style=\"margin-block-end: 0.6rem\">The calling agent is the author, reached through a caller-owned seam.</li><li style=\"margin-block-end: 0.6rem\"><strong>Accepted cost:</strong> a caller that supplies a weak author still gets weak output, and richness cannot be unit-tested.</li></ul></div></section><section class=\"slide\"><div><p style=\"font: 0.8rem/1.4 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-block-end: 0.75rem\">Validation</p><h2 style=\"font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-block: 0 1.25rem; text-wrap: balance\">Evidence, and the limits of that evidence</h2><ul style=\"margin: 0; padding-inline-start: 1.4rem; font-size: clamp(1rem, 1.8vw, 1.35rem); line-height: 1.6; max-width: 46rem\"><li style=\"margin-block-end: 0.6rem\">Core 224 · adapter 59 · smoke 129 · release 44 — plus lint, type-check, and the real-Chromium visual gate.</li><li style=\"margin-block-end: 0.6rem\">The anti-regression fixture was verified non-vacuous: breaking the table renderer fails 6 of 8 assertions.</li><li style=\"margin-block-end: 0.6rem\"><strong>But</strong> three real defects shipped past all of it and were caught by opening the page in a browser.</li></ul></div></section><section class=\"slide\"><div><p style=\"font: 0.8rem/1.4 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-block-end: 0.75rem\">Outcome · next</p><h2 style=\"font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; margin-block: 0 1.25rem; text-wrap: balance\">Judge it by reading the output</h2><p style=\"font-size: clamp(1.1rem, 2.2vw, 1.6rem); line-height: 1.5; max-width: 44rem\">Run the kit on a real project and read what it produces. That is the only test that matters for this change, and the one the redesign was built to pass.</p><p style=\"margin-block-start: 1.5rem; font: 0.85rem/1.5 var(--mono); color: var(--muted)\">PR #179 · 68 commits · explainer-kit 2.0.0</p></div></section>\n      <!-- END AUTHOR EXTENSION REGION -->\n    </main>\n    <nav\n      class=\"deck-controls\"\n      data-shell-anchor=\"deck-controls\"\n      aria-label=\"Slide navigation\"\n    >\n      <button type=\"button\" data-direction=\"-1\" aria-label=\"Previous slide\">\n        ←\n      </button>\n      <span\n        id=\"deck-counter\"\n        data-shell-anchor=\"deck-counter\"\n        aria-live=\"polite\"\n      ></span>\n      <button type=\"button\" data-direction=\"1\" aria-label=\"Next slide\">\n        →\n      </button>\n    </nav>\n    <div\n      class=\"deck-progress\"\n      id=\"deck-progress\"\n      data-shell-anchor=\"deck-progress\"\n      role=\"progressbar\"\n      aria-label=\"Slide progress\"\n      aria-valuemin=\"1\"\n    >\n      <span\n        class=\"deck-progress__bar\"\n        data-shell-anchor=\"deck-progress-bar\"\n      ></span>\n    </div>\n    <script>\n      (() => {\n        const deck = document.querySelector('.deck');\n        const slides = [...document.querySelectorAll('.slide')];\n        const counter = document.querySelector('#deck-counter');\n        const progress = document.querySelector('#deck-progress');\n        const progressBar = progress.querySelector('.deck-progress__bar');\n        const previous = document.querySelector('[data-direction=\"-1\"]');\n        const next = document.querySelector('[data-direction=\"1\"]');\n        const reducedMotion = matchMedia(\n          '(prefers-reduced-motion: reduce)',\n        ).matches;\n        let current = 0;\n\n        const update = (index) => {\n          current = Math.max(0, Math.min(slides.length - 1, index));\n          counter.textContent = `${current + 1} / ${slides.length}`;\n          progress.setAttribute('aria-valuemax', String(slides.length));\n          progress.setAttribute('aria-valuenow', String(current + 1));\n          progressBar.style.width = `${((current + 1) / slides.length) * 100}%`;\n          previous.disabled = current === 0;\n          next.disabled = current === slides.length - 1;\n          history.replaceState(null, '', `#slide-${current + 1}`);\n        };\n        const go = (index) => {\n          update(index);\n          slides[current]?.scrollIntoView({\n            behavior: reducedMotion ? 'auto' : 'smooth',\n            block: 'nearest',\n            inline: 'start',\n          });\n        };\n        document.querySelectorAll('[data-direction]').forEach((button) => {\n          button.addEventListener('click', () =>\n            go(current + Number(button.dataset.direction)),\n          );\n        });\n        addEventListener('keydown', (event) => {\n          if (event.target.closest('input, textarea, [contenteditable]'))\n            return;\n          if (['ArrowRight', 'ArrowDown'].includes(event.key)) {\n            event.preventDefault();\n            go(current + 1);\n          } else if (['ArrowLeft', 'ArrowUp'].includes(event.key)) {\n            event.preventDefault();\n            go(current - 1);\n          }\n        });\n        const observer = new IntersectionObserver(\n          (entries) => {\n            const visible = entries.find((entry) => entry.isIntersecting);\n            if (visible) update(slides.indexOf(visible.target));\n          },\n          { root: deck, threshold: 0.6 },\n        );\n        slides.forEach((slide) => observer.observe(slide));\n        const requested = location.hash.match(/^#slide-(\\d+)$/);\n        go(requested ? Number(requested[1]) - 1 : 0);\n        addEventListener('hashchange', () => {\n          const match = location.hash.match(/^#slide-(\\d+)$/);\n          if (match) go(Number(match[1]) - 1);\n        });\n      })();\n    </script>\n  </body>\n</html>\n"
  },
