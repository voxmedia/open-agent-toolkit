  "schemaVersion": "explainer-kit.author-result/v2",
  "artifactId": "authoring-paths",
  "content": {
    "html": "<!doctype html>\n<!--\n  Neutral production shell. Worked content: ../examples/\n  TEMPLATE CONTRACT: THEME_CSS, TITLE, DESCRIPTION, DIAGRAM, LEGEND\n  DIAGRAM contains validated inline SVG children; external diagram runtimes are not allowed.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Which renderer sees the authored content?</title>\n    <meta name=\"description\" content=\"Recipe policy routes each artifact down one of two paths. The narrative path renders Markdown deterministically; the artistic path has the agent compose HTML. Both converge on the same safety, guideline, and approval checks, so freedom on the artistic path never bypasses validation.\" />\n    <style>\n      :root {\n        --canvas: hsl(210 20% 98%);\n        --panel: hsl(0 0% 100%);\n        --border: hsl(210 14% 80%);\n        --ink: hsl(215 24% 16%);\n        --muted: hsl(215 12% 38%);\n        --accent: hsl(215 28% 32%);\n        --sans: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;\n        --mono: ui-monospace, SFMono-Regular, Consolas, monospace;\n        /* AUTHOR EXTENSION REGION: resolved theme tokens */\n        --canvas: #f4f6f9;\n        --panel: #ffffff;\n        --elevated: #eef1f5;\n        --ink: #16202e;\n        --muted: #4a5568;\n        --accent: #2f56c9;\n        --accent-secondary: #0e7180;\n      }\n      * {\n        box-sizing: border-box;\n      }\n      body {\n        min-height: 100vh;\n        margin: 0;\n        padding: clamp(1rem, 4vw, 3rem);\n        background: var(--canvas);\n        color: var(--ink);\n        font-family: var(--sans);\n      }\n      main {\n        max-width: 80rem;\n        margin: auto;\n      }\n      header {\n        max-width: 55rem;\n        margin-block-end: 1.5rem;\n      }\n      h1 {\n        margin-block: 0 0.4rem;\n        font-size: clamp(2rem, 5vw, 3.5rem);\n        line-height: 1.1;\n        text-wrap: balance;\n      }\n      header p,\n      .diagram-hint {\n        color: var(--muted);\n      }\n      .diagram-shell {\n        position: relative;\n        min-width: 0;\n      }\n      .diagram-hint {\n        font: 0.75rem/1.4 var(--mono);\n      }\n      .diagram-viewport {\n        position: relative;\n        width: 100%;\n        min-height: min(65vh, 40rem);\n        overflow: auto;\n        border: 1px solid var(--border);\n        border-radius: 0.75rem;\n        background: var(--panel);\n        cursor: grab;\n      }\n      .diagram-viewport.is-panning {\n        cursor: grabbing;\n        user-select: none;\n      }\n      .diagram-canvas {\n        display: block;\n        width: 100%;\n        min-width: 42rem;\n        height: auto;\n        transform-origin: top left;\n      }\n      .diagram-canvas text {\n        fill: var(--ink);\n        font-family: var(--sans);\n      }\n      .diagram-canvas .node {\n        fill: var(--panel);\n        stroke: var(--accent);\n      }\n      .diagram-canvas .edge {\n        fill: none;\n        stroke: var(--muted);\n      }\n      .zoom-controls {\n        position: absolute;\n        z-index: 2;\n        inset: 0.6rem 0.6rem auto auto;\n        display: flex;\n        gap: 0.25rem;\n        padding: 0.25rem;\n        border: 1px solid var(--border);\n        border-radius: 0.5rem;\n        background: var(--panel);\n      }\n      .zoom-controls button {\n        min-width: 2rem;\n        min-height: 2rem;\n        border: 0;\n        background: transparent;\n        color: var(--ink);\n        cursor: pointer;\n      }\n      .legend {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 1rem;\n        margin-block-start: 1rem;\n        color: var(--muted);\n        font: 0.8rem/1.5 var(--mono);\n      }\n      @media (max-width: 45rem) {\n        .diagram-canvas {\n          min-width: 34rem;\n        }\n      }\n    </style>\n  </head>\n  <body data-explainer-shell=\"diagram-shell\">\n    <main>\n      <header>\n        <h1 id=\"diagram-title\" data-shell-anchor=\"diagram-title\">Which renderer sees the authored content?</h1>\n        <p id=\"diagram-description\" data-shell-anchor=\"diagram-description\">\n          Recipe policy routes each artifact down one of two paths. The narrative path renders Markdown deterministically; the artistic path has the agent compose HTML. Both converge on the same safety, guideline, and approval checks, so freedom on the artistic path never bypasses validation.\n        </p>\n      </header>\n      <section\n        class=\"diagram-shell\"\n        data-shell-anchor=\"diagram-shell\"\n        aria-labelledby=\"diagram-title\"\n      >\n        <p class=\"diagram-hint\">\n          Use the controls or Ctrl/Command + wheel to zoom; drag to pan.\n        </p>\n        <div\n          class=\"zoom-controls\"\n          data-shell-anchor=\"zoom-controls\"\n          aria-label=\"Diagram zoom\"\n        >\n          <button type=\"button\" data-zoom=\"in\" aria-label=\"Zoom in\">+</button>\n          <button type=\"button\" data-zoom=\"out\" aria-label=\"Zoom out\">−</button>\n          <button type=\"button\" data-zoom=\"reset\" aria-label=\"Reset zoom\">\n            ↺\n          </button>\n        </div>\n        <div class=\"diagram-viewport\" data-shell-anchor=\"diagram-viewport\">\n          <svg\n            class=\"diagram-canvas\"\n            data-shell-anchor=\"diagram-canvas\"\n            viewBox=\"0 0 1200 720\"\n            role=\"img\"\n            aria-labelledby=\"diagram-title diagram-description\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <!-- AUTHOR EXTENSION REGION: accessible inline SVG diagram -->\n            <defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"currentColor\" opacity=\"0.55\"></path></marker></defs><g data-node=\"author-seam\"><rect class=\"node\" x=\"30\" y=\"300\" width=\"210\" height=\"100\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #2f56c9\"></rect><text x=\"135\" y=\"344\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Author seam</text><text x=\"135\" y=\"370\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">caller-owned</text></g><g data-node=\"narrative-renderer\"><rect class=\"node\" x=\"380\" y=\"150\" width=\"230\" height=\"100\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #0e7180\"></rect><text x=\"495\" y=\"194\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Narrative renderer</text><text x=\"495\" y=\"220\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">deterministic</text></g><g data-node=\"artistic-composer\"><rect class=\"node\" x=\"380\" y=\"450\" width=\"230\" height=\"100\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #965108\"></rect><text x=\"495\" y=\"494\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Artistic composer</text><text x=\"495\" y=\"520\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">agent-composed</text></g><g data-node=\"safety-guidelines\"><rect class=\"node\" x=\"690\" y=\"300\" width=\"230\" height=\"100\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #6a4fc4\"></rect><text x=\"805\" y=\"344\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Safety + guidelines</text><text x=\"805\" y=\"370\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">hash-pinned</text></g><g data-node=\"approval\"><rect class=\"node\" x=\"980\" y=\"300\" width=\"200\" height=\"100\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #2f56c9\"></rect><text x=\"1080\" y=\"344\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Approval</text><text x=\"1080\" y=\"370\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">manifest</text></g><path class=\"edge\" d=\"M 240 340 C 310 340 310 200 380 200\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><text x=\"285\" y=\"228\" text-anchor=\"middle\" font-size=\"15\" opacity=\"0.8\" font-family=\"ui-monospace, monospace\">markdown</text><path class=\"edge\" d=\"M 240 360 C 310 360 310 500 380 500\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><text x=\"285\" y=\"487\" text-anchor=\"middle\" font-size=\"15\" opacity=\"0.8\" font-family=\"ui-monospace, monospace\">html</text><path class=\"edge\" d=\"M 610 200 C 650 200 650 340 690 340\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path class=\"edge\" d=\"M 610 500 C 650 500 650 360 690 360\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path class=\"edge\" d=\"M 920 350 L 980 350\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path>\n            <!-- END AUTHOR EXTENSION REGION -->\n          </svg>\n        </div>\n        <div\n          class=\"legend\"\n          data-shell-anchor=\"diagram-legend\"\n          aria-label=\"Diagram legend\"\n        >\n          <!-- AUTHOR EXTENSION REGION: optional visual legend -->\n          <span>Author seam — caller supplies the author</span><span>Narrative — Markdown in, SVG and HTML out</span><span>Artistic — HTML in, validated at the DOM</span><span>Both paths converge before approval</span>\n          <!-- END AUTHOR EXTENSION REGION -->\n        </div>\n      </section>\n    </main>\n    <script>\n      (() => {\n        const viewport = document.querySelector('.diagram-viewport');\n        const canvas = document.querySelector('.diagram-canvas');\n        let zoom = 1;\n        let dragging = false;\n        let originX = 0;\n        let originY = 0;\n        let scrollX = 0;\n        let scrollY = 0;\n        const apply = () => {\n          canvas.style.transform = `scale(${zoom})`;\n        };\n        document.querySelectorAll('[data-zoom]').forEach((button) => {\n          button.addEventListener('click', () => {\n            const action = button.dataset.zoom;\n            zoom =\n              action === 'reset'\n                ? 1\n                : Math.min(\n                    3,\n                    Math.max(0.5, zoom * (action === 'in' ? 1.2 : 0.8)),\n                  );\n            apply();\n          });\n        });\n        viewport.addEventListener(\n          'wheel',\n          (event) => {\n            if (!event.ctrlKey && !event.metaKey) return;\n            event.preventDefault();\n            zoom = Math.min(\n              3,\n              Math.max(0.5, zoom * (event.deltaY < 0 ? 1.1 : 0.9)),\n            );\n            apply();\n          },\n          { passive: false },\n        );\n        viewport.addEventListener('pointerdown', (event) => {\n          dragging = true;\n          originX = event.clientX;\n          originY = event.clientY;\n          scrollX = viewport.scrollLeft;\n          scrollY = viewport.scrollTop;\n          viewport.classList.add('is-panning');\n          viewport.setPointerCapture(event.pointerId);\n        });\n        viewport.addEventListener('pointermove', (event) => {\n          if (!dragging) return;\n          viewport.scrollLeft = scrollX - (event.clientX - originX);\n          viewport.scrollTop = scrollY - (event.clientY - originY);\n        });\n        viewport.addEventListener('pointerup', () => {\n          dragging = false;\n          viewport.classList.remove('is-panning');\n        });\n      })();\n    </script>\n  </body>\n</html>\n"
  },
