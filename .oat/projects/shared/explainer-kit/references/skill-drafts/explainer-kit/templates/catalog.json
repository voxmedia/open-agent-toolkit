    {
      "title": "Systems & Clients Map",
      "type": "diagram",
      "url": "${EXPLAINER_PUBLIC_BASE_URL}/diagrams/<slug>/systems-map/"
    },
    {
      "title": "Status / Where We're At",
      "type": "diagram",
      "url": "${EXPLAINER_PUBLIC_BASE_URL}/diagrams/<slug>/status/"
    },
    {
      "title": "Engineering Explainer",
      "type": "explainer",
      "url": "${EXPLAINER_PUBLIC_BASE_URL}/explainers/<slug>/"
    },
    {
      "title": "Bird's-eye Deck",
      "type": "deck",
      "url": "${EXPLAINER_PUBLIC_BASE_URL}/decks/<slug>/"
