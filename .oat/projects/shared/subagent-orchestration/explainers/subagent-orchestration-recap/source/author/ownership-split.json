  "schemaVersion": "explainer-kit.author-result/v2",
  "artifactId": "ownership-split",
  "content": {
    "html": "<!doctype html>\n<!--\n  Neutral production shell. Worked content: ../examples/\n  TEMPLATE CONTRACT: THEME_CSS, TITLE, DESCRIPTION, DIAGRAM, LEGEND\n  DIAGRAM contains validated inline SVG children; external diagram runtimes are not allowed.\n-->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Which layer is allowed to depend on the other?</title>\n    <meta name=\"description\" content=\"Model-selection guidance is self-contained and can be installed and used on its own, including by agents outside OAT. Dispatch mechanics require guidance in order to choose a target. The dependency runs one way only, which is what lets the portable layer stay portable while dispatch keeps its launch safeguards.\" />\n    <style>\n      :root {\n        --canvas: hsl(210 20% 98%);\n        --panel: hsl(0 0% 100%);\n        --border: hsl(210 14% 80%);\n        --ink: hsl(215 24% 16%);\n        --muted: hsl(215 12% 38%);\n        --accent: hsl(215 28% 32%);\n        --sans: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;\n        --mono: ui-monospace, SFMono-Regular, Consolas, monospace;\n        /* AUTHOR EXTENSION REGION: resolved theme tokens */\n        --canvas: #f4f6f9;\n        --panel: #ffffff;\n        --elevated: #eef1f5;\n        --ink: #16202e;\n        --muted: #4a5568;\n        --accent: #2f56c9;\n        --accent-secondary: #0e7180;\n      }\n      * {\n        box-sizing: border-box;\n      }\n      body {\n        min-height: 100vh;\n        margin: 0;\n        padding: clamp(1rem, 4vw, 3rem);\n        background: var(--canvas);\n        color: var(--ink);\n        font-family: var(--sans);\n      }\n      main {\n        max-width: 80rem;\n        margin: auto;\n      }\n      header {\n        max-width: 55rem;\n        margin-block-end: 1.5rem;\n      }\n      h1 {\n        margin-block: 0 0.4rem;\n        font-size: clamp(2rem, 5vw, 3.5rem);\n        line-height: 1.1;\n        text-wrap: balance;\n      }\n      header p,\n      .diagram-hint {\n        color: var(--muted);\n      }\n      .diagram-shell {\n        position: relative;\n        min-width: 0;\n      }\n      .diagram-hint {\n        font: 0.75rem/1.4 var(--mono);\n      }\n      .diagram-viewport {\n        position: relative;\n        width: 100%;\n        min-height: min(65vh, 40rem);\n        overflow: auto;\n        border: 1px solid var(--border);\n        border-radius: 0.75rem;\n        background: var(--panel);\n        cursor: grab;\n      }\n      .diagram-viewport.is-panning {\n        cursor: grabbing;\n        user-select: none;\n      }\n      .diagram-canvas {\n        display: block;\n        width: 100%;\n        min-width: 42rem;\n        height: auto;\n        transform-origin: top left;\n      }\n      .diagram-canvas text {\n        fill: var(--ink);\n        font-family: var(--sans);\n      }\n      .diagram-canvas .node {\n        fill: var(--panel);\n        stroke: var(--accent);\n      }\n      .diagram-canvas .edge {\n        fill: none;\n        stroke: var(--muted);\n      }\n      .zoom-controls {\n        position: absolute;\n        z-index: 2;\n        inset: 0.6rem 0.6rem auto auto;\n        display: flex;\n        gap: 0.25rem;\n        padding: 0.25rem;\n        border: 1px solid var(--border);\n        border-radius: 0.5rem;\n        background: var(--panel);\n      }\n      .zoom-controls button {\n        min-width: 2rem;\n        min-height: 2rem;\n        border: 0;\n        background: transparent;\n        color: var(--ink);\n        cursor: pointer;\n      }\n      .legend {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 1rem;\n        margin-block-start: 1rem;\n        color: var(--muted);\n        font: 0.8rem/1.5 var(--mono);\n      }\n      @media (max-width: 45rem) {\n        .diagram-canvas {\n          min-width: 34rem;\n        }\n      }\n    </style>\n  </head>\n  <body data-explainer-shell=\"diagram-shell\">\n    <main>\n      <header>\n        <h1 id=\"diagram-title\" data-shell-anchor=\"diagram-title\">Which layer is allowed to depend on the other?</h1>\n        <p id=\"diagram-description\" data-shell-anchor=\"diagram-description\">\n          Model-selection guidance is self-contained and can be installed and used on its own, including by agents outside OAT. Dispatch mechanics require guidance in order to choose a target. The dependency runs one way only, which is what lets the portable layer stay portable while dispatch keeps its launch safeguards.\n        </p>\n      </header>\n      <section\n        class=\"diagram-shell\"\n        data-shell-anchor=\"diagram-shell\"\n        aria-labelledby=\"diagram-title\"\n      >\n        <p class=\"diagram-hint\">\n          Use the controls or Ctrl/Command + wheel to zoom; drag to pan.\n        </p>\n        <div\n          class=\"zoom-controls\"\n          data-shell-anchor=\"zoom-controls\"\n          aria-label=\"Diagram zoom\"\n        >\n          <button type=\"button\" data-zoom=\"in\" aria-label=\"Zoom in\">+</button>\n          <button type=\"button\" data-zoom=\"out\" aria-label=\"Zoom out\">−</button>\n          <button type=\"button\" data-zoom=\"reset\" aria-label=\"Reset zoom\">\n            ↺\n          </button>\n        </div>\n        <div class=\"diagram-viewport\" data-shell-anchor=\"diagram-viewport\">\n          <svg\n            class=\"diagram-canvas\"\n            data-shell-anchor=\"diagram-canvas\"\n            viewBox=\"0 0 1200 720\"\n            role=\"img\"\n            aria-labelledby=\"diagram-title diagram-description\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n          >\n            <!-- AUTHOR EXTENSION REGION: accessible inline SVG diagram -->\n            <defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"currentColor\" opacity=\"0.55\"></path></marker></defs><g data-node=\"direct-user\"><rect class=\"node\" x=\"40\" y=\"100\" width=\"280\" height=\"96\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #0e7180\"></rect><text x=\"180\" y=\"142\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Direct user</text><text x=\"180\" y=\"168\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">or non-OAT agent</text></g><g data-node=\"oat-caller\"><rect class=\"node\" x=\"40\" y=\"470\" width=\"280\" height=\"96\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #2f56c9\"></rect><text x=\"180\" y=\"512\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">OAT caller</text><text x=\"180\" y=\"538\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">lifecycle workflows</text></g><g data-node=\"subagent-orchestration\"><rect class=\"node\" x=\"480\" y=\"80\" width=\"340\" height=\"140\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #0e7180\"></rect><text x=\"650\" y=\"144\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">subagent-orchestration</text><text x=\"650\" y=\"170\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">guidance layer</text></g><g data-node=\"oat-dispatch-subagents\"><rect class=\"node\" x=\"480\" y=\"440\" width=\"340\" height=\"140\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #2f56c9\"></rect><text x=\"650\" y=\"504\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">oat-dispatch-subagents</text><text x=\"650\" y=\"530\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">mechanics layer</text></g><g data-node=\"authorized-route\"><rect class=\"node\" x=\"900\" y=\"470\" width=\"260\" height=\"96\" rx=\"10\" stroke-width=\"2\" style=\"stroke: #6a4fc4\"></rect><text x=\"1030\" y=\"512\" text-anchor=\"middle\" font-size=\"21\" font-weight=\"600\">Authorized route</text><text x=\"1030\" y=\"538\" text-anchor=\"middle\" font-size=\"16\" opacity=\"0.75\">single launch</text></g><path class=\"edge\" d=\"M 320 148 L 480 150\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path class=\"edge\" d=\"M 320 518 L 480 510\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><path class=\"edge\" d=\"M 650 440 L 650 220\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path><text x=\"592\" y=\"340\" text-anchor=\"middle\" font-size=\"15\" opacity=\"0.8\" font-family=\"ui-monospace, monospace\">requires</text><path class=\"edge\" d=\"M 820 510 L 900 515\" stroke-width=\"2\" marker-end=\"url(#arrow)\"></path>\n            <!-- END AUTHOR EXTENSION REGION -->\n          </svg>\n        </div>\n        <div\n          class=\"legend\"\n          data-shell-anchor=\"diagram-legend\"\n          aria-label=\"Diagram legend\"\n        >\n          <!-- AUTHOR EXTENSION REGION: optional visual legend -->\n          <span>Guidance installs alone; dispatch cannot</span><span>Exactly one provider reference per run</span><span>Dispatch fails closed when guidance is absent</span>\n          <!-- END AUTHOR EXTENSION REGION -->\n        </div>\n      </section>\n    </main>\n    <script>\n      (() => {\n        const viewport = document.querySelector('.diagram-viewport');\n        const canvas = document.querySelector('.diagram-canvas');\n        let zoom = 1;\n        let dragging = false;\n        let originX = 0;\n        let originY = 0;\n        let scrollX = 0;\n        let scrollY = 0;\n        const apply = () => {\n          canvas.style.transform = `scale(${zoom})`;\n        };\n        document.querySelectorAll('[data-zoom]').forEach((button) => {\n          button.addEventListener('click', () => {\n            const action = button.dataset.zoom;\n            zoom =\n              action === 'reset'\n                ? 1\n                : Math.min(\n                    3,\n                    Math.max(0.5, zoom * (action === 'in' ? 1.2 : 0.8)),\n                  );\n            apply();\n          });\n        });\n        viewport.addEventListener(\n          'wheel',\n          (event) => {\n            if (!event.ctrlKey && !event.metaKey) return;\n            event.preventDefault();\n            zoom = Math.min(\n              3,\n              Math.max(0.5, zoom * (event.deltaY < 0 ? 1.1 : 0.9)),\n            );\n            apply();\n          },\n          { passive: false },\n        );\n        viewport.addEventListener('pointerdown', (event) => {\n          dragging = true;\n          originX = event.clientX;\n          originY = event.clientY;\n          scrollX = viewport.scrollLeft;\n          scrollY = viewport.scrollTop;\n          viewport.classList.add('is-panning');\n          viewport.setPointerCapture(event.pointerId);\n        });\n        viewport.addEventListener('pointermove', (event) => {\n          if (!dragging) return;\n          viewport.scrollLeft = scrollX - (event.clientX - originX);\n          viewport.scrollTop = scrollY - (event.clientY - originY);\n        });\n        viewport.addEventListener('pointerup', () => {\n          dragging = false;\n          viewport.classList.remove('is-panning');\n        });\n      })();\n    </script>\n  </body>\n</html>\n"
  },
