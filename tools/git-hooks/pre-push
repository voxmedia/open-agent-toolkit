#!/bin/sh
set -u

script_dir=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=tools/git-hooks/repo-toolchain.sh
. "$script_dir/repo-toolchain.sh"

# Fast quality gate before pushing — CI handles tests and full builds
run_pnpm release:check-versions
run_pnpm run cli -- internal validate-skill-version-bumps --base-ref origin/main
run_pnpm run type-check
run_pnpm run lint
run_pnpm run format
