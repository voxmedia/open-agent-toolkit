# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage
tools/smoke/.runs/
tools/smoke/recovery/

# misc
.DS_Store
*.pem

# tsc
*.tsbuildinfo

# build outputs
dist/
build/
packages/cli/assets/*
!packages/cli/assets/public-package-versions.json
# Staging siblings of packages/cli/assets. The rule above ignores that
# directory's contents, not siblings, so a build killed with SIGKILL or a
# cancelled CI job would otherwise leave a ~400-file untracked tree behind.
packages/cli/assets.staging.*
packages/cli/assets.previous.*
apps/oat-docs/site/

# Next.js
.next/

# turborepo
.turbo/

# using pnpm instead of yarn
yarn.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env.*.local

# Claude Code MCP configuration (contains API keys)
.mcp.json

.conductor
.playwright-mcp/

# Git worktrees (local dev only)
.worktrees/
# Ignore claude worktrees
.claude/worktrees/
.claude/worktrees/**

# OAT repo archive (local historical scratch only)
.oat/repo/archive/**

# OAT core
.oat/config.local.json
.oat/state.md
.oat/projects/local/**
.oat/projects/archived/**
!.oat/projects/local/.gitkeep
!.oat/projects/archived/.gitkeep
# END OAT core

