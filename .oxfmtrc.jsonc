{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "quoteProps": "as-needed",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortImports": {},
  "sortPackageJson": {},
  "ignorePatterns": [
    "dist/",
    ".oat/config.json",
    "packages/cli/assets/**",
    // Transient staging siblings created by bundle-assets.sh. They are
    // renamed away mid-build, so a concurrent check would otherwise race and
    // fail with "Failed to read file".
    "packages/cli/assets.staging.*/**",
    "packages/cli/assets.previous.*/**",
    "packages/cli/assets/templates/**/*.yml",
    ".oat/templates/**/*.yml",
    "packages/cli/src/commands/docs/migrate/fixtures/**",
  ],
}
