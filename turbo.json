{
  "$schema": "https://turbo.build/schema.json",

  // Files outside any package that affect builds or tests. Paths are
  // repo-root-relative.
  // .agents/skills/** is included because bundle-assets.sh copies skill files
  // into packages/cli/assets/ during build. Without this, Turbo won't cache-miss
  // when skill content changes (since skills live outside the package directory).
  // .oat/repo/** and apps/oat-docs/docs/** are included for the same reason on
  // the test side: packages/cli's markdown-proto-literal-contract.test.ts
  // enumerates both trees with `git ls-files` and asserts over their content,
  // so without them a change to either leaves the test task's input hash
  // untouched and `pnpm test` replays a cached pass over an unscanned edit.
  // apps/oat-docs/docs/** lives inside the oat-docs package, which invalidates
  // that package's own tasks but not packages/cli's — hence global, not an
  // input on the docs package.
  "globalDependencies": [
    ".agents/skills/**",
    ".oat/repo/**",
    "apps/oat-docs/docs/**"
  ],

  "tasks": {
    "build": {
      // ^build: build dependencies (other workspace packages) first
      "dependsOn": ["^build"],
      // dist/: compiled TypeScript output
      // assets/: bundled skills, templates, and scripts copied by bundle-assets.sh
      "outputs": ["dist/**", "assets/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "check:fix": {
      "dependsOn": ["^build"]
    },
    "dev": {
      // Never cache dev server — always run fresh
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      // build (not ^build): tests depend on the SAME package's build, not just dependencies
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    },
    "format": {
      "dependsOn": ["^build"]
    },
    "format:fix": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
