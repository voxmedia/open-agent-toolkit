{
  "schemaVersion": "explainer-kit.browser-evidence/v1",
  "artifactId": "deck",
  "viewport": "mobile",
  "viewportSize": {
    "width": 320,
    "height": 640
  },
  "scenario": "default",
  "capture": {
    "format": "png",
    "fullPage": false,
    "reducedMotion": "reduce",
    "animationsDisabled": true
  },
  "screenshotPath": "qa/browser/deck/mobile.png",
  "metrics": {
    "pageOverflowX": false,
    "clippedX": [],
    "viewportClipped": [],
    "unreadableHeadings": [],
    "animationsDisabled": true,
    "reducedMotion": true,
    "deckLayout": {
      "flow": "horizontal",
      "overflowX": "auto"
    },
    "themeToggle": null,
    "keyboard": {
      "tab": true,
      "arrows": {
        "ArrowLeft": true,
        "ArrowRight": true,
        "ArrowUp": true,
        "ArrowDown": true
      }
    }
  }
}
