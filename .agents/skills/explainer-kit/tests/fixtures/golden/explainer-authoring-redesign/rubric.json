{
  "schemaVersion": "explainer-kit.golden-rubric/v1",
  "checks": {
    "adaptiveMinimumSet": {
      "required": true,
      "evidence": [
        "evidence/browser-evidence.json#/setPlan/portfolio",
        "evidence/browser-evidence.json#/manifest/artifacts"
      ]
    },
    "firstViewport": {
      "required": true,
      "evidence": [
        "evidence/browser-evidence.json#/screenshots/desktop",
        "evidence/browser-evidence.json#/screenshots/tablet",
        "evidence/browser-evidence.json#/screenshots/mobile"
      ]
    },
    "hierarchy": {
      "required": true,
      "evidence": ["evidence/browser-evidence.json#/visualReview/hierarchy"]
    },
    "representationChoice": {
      "required": true,
      "evidence": [
        "evidence/browser-evidence.json#/setPlan/visualIntent",
        "evidence/browser-evidence.json#/visualReview/representationChoice"
      ]
    },
    "legibility": {
      "required": true,
      "evidence": ["evidence/browser-evidence.json#/browserMetrics"]
    },
    "cohesion": {
      "required": true,
      "evidence": [
        "evidence/browser-evidence.json#/setPlan/ledger",
        "evidence/browser-evidence.json#/visualReview/cohesion"
      ]
    },
    "sourceCoverage": {
      "required": true,
      "evidence": ["evidence/browser-evidence.json#/sourceCoverage"]
    },
    "interactions": {
      "required": true,
      "evidence": ["evidence/browser-evidence.json#/browserMetrics"]
    },
    "topologyPreservation": {
      "required": true,
      "evidence": [
        "source-input.json#/topology",
        "evidence/browser-evidence.json#/visualReview/topology"
      ]
    },
    "catalogParity": {
      "required": true,
      "evidence": [
        "evidence/browser-evidence.json#/manifest/artifacts",
        "evidence/browser-evidence.json#/catalog/artifacts"
      ]
    },
    "boundedCorrection": {
      "required": true,
      "evidence": ["evidence/browser-evidence.json#/reviewHistory"]
    }
  }
}
