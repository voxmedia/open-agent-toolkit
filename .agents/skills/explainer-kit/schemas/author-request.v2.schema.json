{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explainer-kit.author-request/v2",
  "title": "AuthorRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactType",
    "authoring",
    "brief",
    "visualAuthoringGuidance",
    "factBase",
    "theme",
    "setContext",
    "plannedArtifact"
  ],
  "properties": {
    "schemaVersion": { "const": "explainer-kit.author-request/v2" },
    "artifactId": { "type": "string", "minLength": 1 },
    "artifactType": {
      "enum": ["hub", "diagram", "explainer", "deck", "catalog"]
    },
    "authoring": { "enum": ["markdown", "html"] },
    "brief": { "type": "string", "minLength": 1 },
    "visualAuthoringGuidance": { "type": "string", "minLength": 1 },
    "factBase": { "$ref": "explainer-kit.fact-base/v1" },
    "shell": { "type": "string", "minLength": 1 },
    "theme": { "$ref": "explainer-kit.theme/v1" },
    "setContext": { "$ref": "explainer-kit.set-plan/v1" },
    "plannedArtifact": { "$ref": "#/$defs/plannedArtifact" },
    "graphSemantics": {
      "type": "array",
      "items": { "$ref": "#/$defs/graphSemantics" },
      "minItems": 1
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredNarrative"],
      "properties": {
        "requiredNarrative": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "graphSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "nodes", "edges", "topology"],
      "properties": {
        "direction": { "enum": ["TD", "LR"] },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "shape", "explicit"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "shape": { "enum": ["rectangle", "rounded", "diamond"] },
              "explicit": { "type": "boolean" }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind", "label"],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "to": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
              "kind": { "enum": ["arrow", "line"] },
              "label": { "type": "string" }
            }
          },
          "minItems": 1
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "features",
            "branchNodes",
            "fanInNodes",
            "cycle",
            "order"
          ],
          "properties": {
            "kind": { "const": "non-linear" },
            "features": {
              "type": "array",
              "items": {
                "enum": [
                  "branch",
                  "fan-in",
                  "cycle",
                  "disconnected",
                  "non-linear"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "branchNodes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "uniqueItems": true
            },
            "fanInNodes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "uniqueItems": true
            },
            "cycle": { "type": "boolean" },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "maxItems": 0
            }
          }
        }
      }
    },
    "plannedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactType",
        "profileId",
        "required",
        "sourceIds",
        "draft",
        "visualIntent"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "artifactType": {
          "enum": ["hub", "diagram", "explainer", "deck", "catalog"]
        },
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "required": { "type": "boolean" },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "draft": { "type": "string", "minLength": 1 },
        "visualIntent": { "type": "string", "minLength": 1 },
        "justification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceIds", "rationale"],
          "properties": {
            "kind": {
              "enum": [
                "status-change",
                "rollout-complexity",
                "source-backed-detail"
              ]
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "rationale": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
