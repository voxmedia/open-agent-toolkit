{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explainer-kit.visual-review-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestHash",
    "attempt",
    "disposition",
    "reasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "explainer-kit.visual-review-evidence/v1"
    },
    "requestHash": { "$ref": "#/$defs/hash" },
    "attempt": { "enum": [1, 2] },
    "disposition": { "enum": ["pass", "correct", "failed"] },
    "reasons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/reason" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "kind", "count"],
      "properties": {
        "stage": {
          "enum": [
            "planning",
            "authoring",
            "rendering",
            "link-validation",
            "browser-review",
            "visual-review",
            "durability",
            "finalization"
          ]
        },
        "kind": {
          "enum": [
            "finding",
            "provider-failure",
            "pipeline-failure",
            "superseded"
          ]
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "count": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    }
  }
}
