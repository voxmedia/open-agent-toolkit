{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explainer-kit.manifest/v2",
  "title": "ArtifactManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "slug",
    "recipe",
    "createdAt",
    "mode",
    "source",
    "theme",
    "artifacts",
    "immutableHashes",
    "outcome",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "explainer-kit.manifest/v2" },
    "runId": { "type": "string", "minLength": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["unattended", "interactive"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factBasePath", "factBaseHash", "inputHashes"],
      "properties": {
        "factBasePath": { "$ref": "#/$defs/safeRelativePath" },
        "factBaseHash": { "$ref": "#/$defs/hash" },
        "inputHashes": { "$ref": "#/$defs/hashMap" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "const": "theme.resolved.json" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactEntry" },
      "minItems": 1,
      "uniqueItems": true
    },
    "immutableHashes": { "$ref": "#/$defs/hashMap" },
    "outcome": {
      "enum": ["built", "built-needs-review", "failed", "incomplete"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\).+$"
    },
    "hashMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/safeRelativePath" },
      "additionalProperties": { "$ref": "#/$defs/hash" }
    },
    "artifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "contentPath", "hash", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["hub", "diagram", "explainer", "deck", "catalog"] },
        "contentPath": { "$ref": "#/$defs/safeRelativePath" },
        "hash": { "$ref": "#/$defs/hash" },
        "status": { "enum": ["built", "failed"] }
      }
    }
  }
}
