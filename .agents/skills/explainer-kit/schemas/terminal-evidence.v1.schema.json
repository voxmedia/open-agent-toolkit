{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explainer-kit.terminal-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "outcome",
    "reasons",
    "evidenceDisposition"
  ],
  "properties": {
    "schemaVersion": {
      "const": "explainer-kit.terminal-evidence/v1"
    },
    "runId": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "outcome": {
      "enum": ["built-needs-review", "failed"]
    },
    "manifestHash": { "$ref": "#/$defs/hash" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/reason" }
    },
    "evidenceDisposition": {
      "enum": ["retained", "partial", "unavailable", "superseded"]
    },
    "supersededBy": { "$ref": "#/$defs/supersededBy" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "kind", "count"],
      "properties": {
        "stage": {
          "enum": [
            "planning",
            "authoring",
            "rendering",
            "link-validation",
            "browser-review",
            "visual-review",
            "durability",
            "finalization"
          ]
        },
        "kind": {
          "enum": [
            "finding",
            "provider-failure",
            "pipeline-failure",
            "superseded"
          ]
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "count": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "supersededBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "manifestHash"],
      "properties": {
        "runId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "manifestHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
