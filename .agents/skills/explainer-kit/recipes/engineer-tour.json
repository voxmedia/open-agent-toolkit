{
  "schemaVersion": "explainer-kit.recipe/v2",
  "id": "engineer-tour",
  "version": "1",
  "sourceRoles": [
    {
      "role": "codebase",
      "required": true,
      "accepts": ["directory", "git"],
      "minBindings": 1,
      "maxBindings": 1
    }
  ],
  "floor": [
    {
      "id": "engineer-tour",
      "type": "explainer",
      "authoring": "html",
      "template": "engineer-tour",
      "required": true,
      "briefRef": "briefs/engineer-tour.md",
      "requiredNarrative": [
        "orientation",
        "architecture",
        "execution-flow",
        "key-code",
        "validation"
      ]
    }
  ],
  "expansion": {
    "profiles": [
      {
        "profileId": "supporting-diagram",
        "type": "diagram",
        "authoring": "html",
        "briefRef": "briefs/supporting-diagram.md",
        "shell": "diagram-shell",
        "maxCount": 4
      }
    ],
    "limits": {
      "maxArtifacts": 4
    }
  },
  "discoveryLimits": {
    "consecutiveNoNewFindingsRounds": 2,
    "maxRounds": 8
  }
}
