{
  "schemaVersion": "explainer-kit.recipe/v2",
  "id": "project-recap",
  "version": "1",
  "sourceRoles": [
    {
      "role": "project",
      "required": true,
      "accepts": ["file", "directory", "git", "github"],
      "minBindings": 1,
      "maxBindings": 1
    }
  ],
  "floor": [
    {
      "id": "project-recap",
      "type": "hub",
      "authoring": "html",
      "template": "house-style",
      "required": true,
      "briefRef": "briefs/project-recap.md",
      "requiredNarrative": [
        "original-request",
        "key-agent-decisions",
        "as-built-architecture",
        "implementation-record",
        "validation-evidence",
        "outcome"
      ]
    },
    {
      "id": "architecture",
      "type": "diagram",
      "authoring": "html",
      "template": "diagram-shell",
      "required": true,
      "briefRef": "briefs/supporting-diagram.md",
      "requiredNarrative": ["as-built-architecture"]
    },
    {
      "id": "deck",
      "type": "deck",
      "authoring": "html",
      "template": "deck-shell",
      "required": true,
      "briefRef": "briefs/walkthrough-deck.md",
      "requiredNarrative": ["outcome"]
    }
  ],
  "expansion": {
    "profiles": [
      {
        "profileId": "status-view",
        "type": "explainer",
        "authoring": "html",
        "briefRef": "briefs/project-recap.md",
        "shell": "house-style",
        "maxCount": 1,
        "allowedJustificationKinds": ["status-change"]
      },
      {
        "profileId": "rollout-view",
        "type": "explainer",
        "authoring": "html",
        "briefRef": "briefs/project-recap.md",
        "shell": "house-style",
        "maxCount": 1,
        "allowedJustificationKinds": ["rollout-complexity"]
      },
      {
        "profileId": "deep-dive",
        "type": "explainer",
        "authoring": "markdown",
        "briefRef": "briefs/deep-dive.md",
        "maxCount": 3,
        "allowedJustificationKinds": ["source-backed-detail"]
      }
    ],
    "limits": {
      "maxArtifacts": 5
    }
  },
  "discoveryLimits": {
    "consecutiveNoNewFindingsRounds": 2,
    "maxRounds": 8
  }
}
